# LLM -- optional. Powers the Diagnosis free-text fallback + Recovery outreach
# drafting. With NO key set, both agents degrade to deterministic behaviour and
# everything still runs. Provider is auto-detected: anthropic -> openrouter ->
# openai (or force it with LLM_PROVIDER). See app/llm.py.
#
# Option A -- Anthropic direct:
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
#
# Option B -- OpenRouter (OpenAI-compatible; default model is still Claude, so
# the "built on Claude" story holds):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
#
# Option C -- OpenAI direct:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=openrouter   # force a provider instead of auto-detect

# Sarvam AI text-to-speech -- optional. Powers the Hinglish Voice Recovery
# Agent's spoken call playback (app/agents/voice_tts.py, GET
# /api/events/{id}/voice/audio). With NO key, the endpoint returns
# {available: false} and the dashboard falls back to the browser voice.
# NOTE: get_settings() is @lru_cache'd -- a running `uvicorn` process will
# NOT pick up a change to this file. Restart the server after editing it.
# The frontend also needs frontend/.env with VITE_DATA_SOURCE=live (the
# default `fixtures` mode never calls the backend at all, Sarvam included).
# SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_LANGUAGE_CODE=hi-IN
# SARVAM_TTS_SPEAKER_AGENT=priya
# SARVAM_TTS_SPEAKER_CUSTOMER=rahul
# SARVAM_TTS_SAMPLE_RATE=22050

# Razorpay TEST MODE ONLY -- never real keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# The payment-capture engine (app/agents/payment.py) uses the deterministic
# fake gateway by DEFAULT even when the keys above are set. Razorpay's test
# mode caps a business account at 30 payment links total -- once hit, every
# real call fails (429 RATE_LIMIT_EXCEEDED) and silently falls back anyway,
# so auto-attempting the real API just because keys exist is a trap, not a
# feature. Set this to true only when you deliberately want to demo the real
# Razorpay Payment Links integration (and are under the 30-link cap).
USE_REAL_RAZORPAY_PAYMENT_LINKS=false

# Postgres. SQLAlchemy URL: dialect+driver is `postgresql+psycopg` (psycopg 3).
# Local server managed by scripts/pg.ps1 (Docker needs WSL2, unavailable here).
DATABASE_URL=postgresql+psycopg://revrec:revrec@localhost:5432/revrec

# Used only by the test suite. `scripts/pg.ps1 install` creates this database.
TEST_DATABASE_URL=postgresql+psycopg://revrec:revrec@localhost:5432/revrec_test

# CORS: where the frontend dev server runs
FRONTEND_ORIGIN=http://localhost:5173
